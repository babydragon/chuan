[Unit]
Description=chuan oauth-mcp (OAuth provider helper)
After=network-online.target

[Service]
User=chuan
Group=chuan
ExecStart=/usr/local/bin/chuan oauth-mcp serve --dir /var/lib/chuan/oauth --host 127.0.0.1 --port 8790
Restart=on-failure
RestartSec=2
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/chuan/oauth

[Install]
WantedBy=multi-user.target
