# chuan 配置示例（生产路径）。
# 优先级：CLI > 环境变量 > 本文件 > 内置默认。
# 密钥只通过 *_file 引用，不要写在这里。

[app]
name = "home"
# 定时任务用的本地时区偏移（不做 DST）
utc_offset = "+08:00"
timezone = "Asia/Shanghai"

[telegram]
allowed_users = [123456789]
stale_after_s = 300
# 生产用 systemd 凭据时，由 unit 的 CHUAN_TELEGRAM_TOKEN_FILE=%d/telegram_token 覆盖
token_file = "~/.config/chuan/secrets/telegram_token"

[engine]
# echo（离线回显）| zai | opencode-go
provider = "zai"
model = "glm-5.3-flash"
api_key_file = "~/.config/chuan/secrets/zai_key"
# base_url = "..."                 # 覆盖预设；以 /chat/completions 结尾则原样用
# proxy = "http://127.0.0.1:7890"  # 模型走代理；不写=直连
# system 指令是"核心段写死 + 只能追加"（D21）：核心段编译进二进制、不可替换，
# 这里配的文件只追加在它之后。改完 systemctl restart chuan 生效；`/prompt` 可查看最终全文。
# system_prompt_append_file = "/etc/chuan/prompts/extra.md"
# 旧名 system_prompt_extra_file 仍兼容；system_prompt_file（整体替换）已废弃并会启动报错。

[actor]
max_turns = 8
# 0 = 不限（长任务优先）；靠 max_turns 与 /cancel 收口
wall_clock_ms = 0
# /ws 是草稿区：按天 + 总量清理（0 = 该维度不设限）
workspace_keep_days = 7
workspace_max_mb = 256
# 上下文预算（token）；超出后按轮裁剪旧对话
context_budget_tokens = 24000
workspace = "/var/lib/chuan/workspaces"
# 用户投递目录：只读挂到沙盒 /inbox
inbox = "/var/lib/chuan/inbox"

[lanes]
# 并发按资源类型限流（D11），不是按请求数。SBC 上不要调大。
io = 2          # 文件、短命令
compile = 1     # 编译/装包/技能 dry-run
external = 1    # 模型请求（并发 1 时前台与子 agent 会轮流用，首字可能等一步）
agent = 1       # 子 agent 并发

[agents]
# 子 agent（D19/D20）。enabled=false 时 delegate 一律拒绝。
enabled = true
max_per_run = 2          # 单个 run 最多派几个
max_turns = 6            # 单个子 agent 的轮数上限
max_tokens = 20000       # 单个子 agent 的 token 预算
wall_ms = 120000         # 单个子 agent 的墙钟上限（0 = 不限，不推荐）
background_idle_s = 5    # 前台静默多久才启动后台任务
roles_dir = "/etc/chuan/roles"
# 角色：模型只能点名，内容由配置或 agent 的 role 工具写入（热加载）。
# 现成角色与日常话术见 docs/ROLES.md。
# [agents.roles.coder]
# tools = ["read", "write", "exec", "playbook"]
# max_turns = 10
# max_tokens = 40000
# wall_ms = 300000

[budget]
# 0 = 不限。按本地自然日/月统计；超限在 run 入口与 delegate 前直接拒绝。
daily_tokens = 0
monthly_tokens = 0

[storage]
db = "/var/lib/chuan/chuan.db"
lock = "/var/lib/chuan/chuan.lock"

[skills]
dir = "/var/lib/chuan/skills"
# 沉淀流程说明（SOP）。**可选**：留空用内置文本；填了就必须存在，否则启动失败。
# 想改流程时先 `mkdir -p /etc/chuan/prompts` 再写文件，然后取消下面这行注释。
# distill_prompt_file = "/etc/chuan/prompts/distill.md"
# 操作规范目录（playbook）：<name>.md 覆盖内置文本。安装脚本会建好这个目录
playbooks_dir = "/etc/chuan/playbooks"

[identity]
# 一个人可以有多个通道地址；找不到绑定时用 default_user
default_user = "owner"

[[identity.user]]
id = "owner"
name = "主人"
channels = ["telegram:123456789"]

[policy]
# 审批轴是"执行域"（能力越界），不是命令黑名单：
#   sandbox      沙盒内（/ws 可写、宿主不可见、无网络）→ 问也没用
#   self_modify  改自身（装/回滚技能、改配置）        → 该问
#   outbound     出网：真正的闸是域名白名单          → 白名单内免问
#   host         宿主执行（L1，chuan 身份）           → 默认逐条问
#   host_elevated 宿主提权（L2，经 chuan hostd）      → 默认关闭
#   host_observe 宿主只读观测（/proc、systemctl）      → 免问
sandbox = "allow"
self_modify = "ask"
outbound = "allow"
lan = "ask"        # 内网调试（有网卡）：局域网与公网都可达，靠审批兜底
install = "ask"    # 装依赖（pip/npm）
# P4.6 实现前，下面三项只是占位（未知键会被忽略），不会放宽任何东西
host_observe = "allow"
host = "ask"
host_elevated = "deny"
# 额外加严的工具名（只能加严，不能放松 host_elevated = "deny"）
require_approval = []

# ---- 宿主执行（D22）----
# 缺省 approval = "always"：写进表 = 默认挂载 + 免问；"once" = 默认不挂、每次点名（只读）。
# 改这个文件后**不用重启**：按 mtime 热加载。
[host]
net = "host"                 # 共享宿主 netns（systemctl --user / 本机代理都要）

[host.path]
"/usr"                = { mode = "ro" }   # 二进制与库；merged-usr 上 /bin /lib 由程序补软链
"/etc"                = { mode = "ro" }   # 读配置；secrets / services.d / chuan.toml 会被强制遮蔽
"/proc"               = { mode = "ro" }   # 宿主进程视图（不换 pid namespace）
"/sys"                = { mode = "ro" }   # 温度、频率、cgroup
"/var/log/journal"    = { mode = "ro" }   # journalctl（需 systemd-journal 组）
"/run/systemd/system" = { mode = "ro" }   # sd_booted()；缺了 systemctl 会报 "not booted"
"/run/dbus"           = { mode = "ro" }   # 系统总线（systemctl 用）
"/run/user/%U"        = { mode = "ro" }   # systemctl --user 的控制 socket（只连不写）
"/var/lib/chuan/.config" = { mode = "rw" }  # user unit 文件
"/var/lib/chuan/timers"  = { mode = "rw" }  # 监控脚本
# 要读别的目录就点名（只读、弹卡）：host(grant=["/home/you/report.csv"])
# "/home" = { mode = "ro", approval = "once" }

# 提权授权：argv 前缀匹配，没有 shell。**换发行版只改这里，不改代码**。
# `approval = "always"` 的条目免审批——只读预览（apt -s / emerge --pretend）适合放进去；
# `once` 是真会改系统的动作。`snapshot_argv` 会在执行前把 stdout 存进 pkg-snapshots。
# [[host_elevated.grant]]
# argv = ["/usr/bin/apt-get", "install"]
# approval = "once"
# snapshot_argv = ["/usr/bin/dpkg", "--get-selections"]
#
# Gentoo 示意：
# [[host_elevated.grant]]
# argv = ["/usr/bin/emerge", "--pretend"]
# approval = "always"
# [[host_elevated.grant]]
# argv = ["/usr/bin/emerge"]
# approval = "once"
# snapshot_argv = ["/usr/bin/qlist", "-I"]

# 命名服务（可选）。kind = "http"（默认）或 "mcp"；token 只放凭据文件，权限 0600
# 运行时新增的服务由 agent 通过 service 工具写到 <config>/services.d/<name>.toml，
# 下次启动自动合并（同名覆盖本节里的定义）
# [services.dida]
# kind = "mcp"                      # mcp 走 Streamable HTTP
# base = "https://mcp.dida365.com"
# token_file = "/etc/chuan/secrets/dida_token"
# tools = ["create_task", "list_undone_tasks_by_time_query"]   # 可选：只暴露这些

# —— 带签名的 webhook（钉钉 / 飞书）示例 ——
# 凭据文件两行：第 1 行 token（或 hook id），第 2 行 secret。值只在宿主侧使用。
#
# [services.dingtalk]
# base = "https://oapi.dingtalk.com"        # 只到域名；/robot/send 由调用时的 path 给
# token_file = "/etc/chuan/secrets/dingtalk"       # 第 1 行 access_token，第 2 行 SEC 密钥
# header = ""                                       # 钉钉不用 header
# query = { access_token = "{token}", timestamp = "{ts_ms}", sign = "{sign}" }
# sign = { canonical = "{ts_ms}\n{secret}" }
#
# [services.feishu]
# base = "https://open.feishu.cn"
# token_file = "/etc/chuan/secrets/feishu"          # 第 1 行 hook id，第 2 行 secret
# header = ""
# body = { timestamp = "{ts_s}", sign = "{sign}" }   # 飞书加签在 body 里，用秒
# sign = { canonical = "{ts_s}\n{secret}" }
# 调用：http(service="feishu", method="POST",
#            path="/open-apis/bot/v2/hook/{token}", body={...})

[proxy]
# 宿主上的 HTTP 代理；留空则沿用 https_proxy / http_proxy
url = "http://127.0.0.1:7890"
sandbox = "auto"      # auto = 只在 exec(proxy=true) 时注入
web_fetch = "auto"    # auto = 直连失败再试代理
services = "never"    # http/mcp 默认直连

[vision]
# 开启后图片会作为多模态内容发给模型厂商（会外传，自行决定）
enabled = false

[media]
# 聊天附件落盘（只读挂到沙盒 /media），30 天清理
dir = "/var/lib/chuan/media"
keep_days = 30

[library]
dir = "/var/lib/chuan/files"

[sandbox]
# 显式授权给沙盒的宿主挂载（默认空）。例：打印技能要用 CUPS
# mounts = [{ src = "/run/cups", dst = "/run/cups", ro = true }]

[net]
log = "/var/lib/chuan/net-access.jsonl"

[runtime]
dir = "/var/lib/chuan/rt"
# pip_index = "https://mirrors.tuna.tsinghua.edu.cn/pypi/web/simple"

[backup]
dir = "/var/lib/chuan/backups"
keep_days = 7
keep_min = 2
max_total_mb = 256
