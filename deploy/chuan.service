[Unit]
Description=chuan home assistant
After=network-online.target
Wants=network-online.target
# 崩溃循环熔断：10 分钟内 5 次则进入 failed
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=chuan
Group=chuan
SupplementaryGroups=lp systemd-journal
WorkingDirectory=/var/lib/chuan
ExecStart=/usr/local/bin/chuan --config /etc/chuan/chuan.toml
Restart=always
RestartSec=2

# 状态与配置目录
StateDirectory=chuan
StateDirectoryMode=0750
ConfigurationDirectory=chuan
ConfigurationDirectoryMode=0750

# 凭据：root 读取，按 fd 注入，不进 environ（见 docs/OPS.md §2）
LoadCredential=telegram_token:/etc/chuan/secrets/telegram_token
LoadCredential=zai_key:/etc/chuan/secrets/zai_key
Environment=CHUAN_TELEGRAM_TOKEN_FILE=%d/telegram_token
Environment=CHUAN_KEY_FILE=%d/zai_key

Environment=MALLOC_ARENA_MAX=2

# 加固
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# 注意：不要加 ProtectKernelTunables=yes / ProtectKernelLogs=yes / ProtectHostname=yes。
# 前两者会让 systemd 先动 /proc，后者与其他 namespace 项叠加时会与 bwrap 冲突：
# bwrap 在自己的 mount namespace 里挂全新 procfs 会被内核拒绝：
#   bwrap: Can't mount proc on /proc: Operation not permitted
# 后果是 daemon 照常启动、沙盒与联网 lane 全部失效，只有真跑命令才暴露。
# 用下面几项替代（等价收益，且与 bwrap 兼容；scripts/check-sandbox-unit.sh 会实测）。
ProtectKernelModules=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/chuan
# 注意：不要在这里写 ReadWritePaths=/run/user/%U —— system 单元里 %U 恒为 0
# （它指"运行 service manager 的用户"），会变成 /run/user/0 导致 226/NAMESPACE。
# 宿主 lane 只需要**连** /run/user/<uid>/systemd/private，只读挂载即可；
# 真要可写就写死实际 uid（install.sh 知道它），但那不是当前需要。
MemoryMax=1G

[Install]
WantedBy=multi-user.target
