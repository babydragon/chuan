[Unit]
Description=chuan home assistant
After=network-online.target
Wants=network-online.target
# 崩溃循环熔断：10 分钟内 5 次则进入 failed
StartLimitIntervalSec=600
StartLimitBurst=5

[Service]
Type=simple
User=chuan
Group=chuan
SupplementaryGroups=lp systemd-journal
WorkingDirectory=/var/lib/chuan
ExecStart=/usr/local/bin/chuan --config /etc/chuan/chuan.toml
Restart=always
RestartSec=2
# 配置错误（退出码 2）不重试：凭据缺失 / [identity] 为空这类问题重启一万次也没用，
# 只会把 StartLimitBurst 打满，让人误以为"服务崩了"。
RestartPreventExitStatus=2

# 状态与配置目录
StateDirectory=chuan
StateDirectoryMode=0750
ConfigurationDirectory=chuan
ConfigurationDirectoryMode=0750
# 外部适配器的 UDS 放在这里（D44）：目录可穿越，socket 本身 0600。
RuntimeDirectory=chuan
RuntimeDirectoryMode=0755

# 凭据：root 读取，按 fd 注入，不进 environ（见 docs/OPS.md §2）
LoadCredential=telegram_token:/etc/chuan/secrets/telegram_token
LoadCredential=zai_key:/etc/chuan/secrets/zai_key
Environment=CHUAN_TELEGRAM_TOKEN_FILE=%d/telegram_token
Environment=CHUAN_KEY_FILE=%d/zai_key

Environment=MALLOC_ARENA_MAX=2

# 加固
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectSystem=strict
ProtectHome=read-only
# 注意：不要加 ProtectKernelTunables=yes / ProtectKernelLogs=yes / ProtectHostname=yes。
# 前两者会让 systemd 先动 /proc，后者与其他 namespace 项叠加时会与 bwrap 冲突：
# bwrap 在自己的 mount namespace 里挂全新 procfs 会被内核拒绝：
#   bwrap: Can't mount proc on /proc: Operation not permitted
# 后果是 daemon 照常启动、沙盒与联网 lane 全部失效，只有真跑命令才暴露。
# 用下面几项替代（等价收益，且与 bwrap 兼容；scripts/check-sandbox-unit.sh 会实测）。
ProtectKernelModules=yes
ProtectClock=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
ReadWritePaths=/var/lib/chuan
# agent 会改的配置子目录（自改事务，D35）：ProtectSystem=strict 下 /etc 是只读的，
# 不显式放开就是 EROFS——本机就出过"publish_playbook 写临时文件被拒"。
# 只放开这几个子目录；chuan.toml 与 secrets 仍只读。前缀 `-`：目录缺失时不拖垮启动。
ReadWritePaths=-/etc/chuan/playbooks -/etc/chuan/services.d -/etc/chuan/roles -/etc/chuan/commands.d -/etc/chuan/capabilities
# 可写「天花板」：通用挂载点在这里**一次性**放开，之后加可写目录只改 chuan.toml 的
# [host.path]，不用再动 unit。
#   /mnt    网络盘、永久挂载（NAS 之类）
#   /media  可移动介质（udisks 挂载点）
#   /srv    服务数据
#   /run/media  另一种可移动介质挂载根（可能不存在，加 `-`）
# 为什么必须在这里放开：ProtectSystem=strict 把整棵树挂成只读，bwrap 的 --bind 只继承
# 源的 MS_RDONLY（user namespace 里 remount rw 会 EPERM），于是"授权表写了 rw、工具却报
# 只读"。2026-11-16 板上为此误判过两轮（先怀疑 NAS，再怀疑 fstab）。
# 这层只是天花板，不放权：没写进 [host.path] 的路径宿主 lane 里根本看不见，
# 标 ro 的照样 --ro-bind——"给不给 agent"始终只由授权表决定（D22）。
# 数据不在这些位置（例如在 /home 下）时，再按需加一条，前缀 `-` 让路径缺失不拖垮启动：
#   ReadWritePaths=-/srv/data
ReadWritePaths=-/mnt -/media -/srv -/run/media
# 注意：不要在这里写 ReadWritePaths=/run/user/%U —— system 单元里 %U 恒为 0
# （它指"运行 service manager 的用户"），会变成 /run/user/0 导致 226/NAMESPACE。
# 宿主 lane 只需要**连** /run/user/<uid>/systemd/private，只读挂载即可；
# 真要可写就写死实际 uid（install.sh 知道它），但那不是当前需要。
MemoryMax=1G

[Install]
WantedBy=multi-user.target
